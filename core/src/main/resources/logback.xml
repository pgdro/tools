<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>
<configuration>
    <!-- Silencing internal messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <!-- global Log Properties -->
    <property name="LOG_DIR" value="${myapp.log.dir:-${java.io.tmpdir}/pgdro.tools/logs}"/>
    <property name="MAX_FILE_SIZE" value="10MB"/>
    <property name="MAX_HISTORY_DAYS" value="30"/>
    <property name="PATTERN_LAYOUT" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} [%-5level] [%thread] %logger [%file:%line %M] - %msg%n"/>
    <!-- <property name="PATTERN_LAYOUT" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} [%-6p] %C{3}.%M(%F:%L) - %msg%n"/> -->
    <property name="ROOT_LEVEL" value="${myapp.log.level:-INFO}"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>
    <!-- Error file attributes -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR}/error.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_LAYOUT}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>
    <!-- other except Error file attributes -->
    <appender name="OTHER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/other.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR}/other.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_LAYOUT}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
    </appender>
    <!-- Asynchronous  mode for OTHER_FILE -->
    <appender name="ASYNC_OTHER_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="OTHER_FILE"/>
    </appender>
    <!-- root File management -->
    <root level="${ROOT_LEVEL}">
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="OTHER_FILE"/>
    </root>
</configuration>